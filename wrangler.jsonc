{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "southbag-social",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  // Uncomment once the domain is ready:
  // "routes": [{ "pattern": "social.southbag.cc", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Static files are served for free without waking the Worker. Only these paths run code.
    "run_worker_first": ["/api/*", "/auth/*", "/media/*"],
    "not_found_handling": "single-page-application"
  },
  // Everything — posts, profiles, and every photo and video byte — lives in D1.
  // DB holds the social graph and file metadata. MEDIA holds file chunks. The free plan caps a
  // D1 database at 500 MB (10 databases per account), so extra chunk stores can be added as
  // MEDIA_1, MEDIA_2, … and new uploads spread across them automatically (see src/lib/media.ts).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "southbag-social",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    },
    {
      "binding": "MEDIA",
      "database_name": "southbag-social-media",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations-media"
    }
  ],
  "triggers": {
    // Hourly janitor: expired stories, abandoned uploads, dead sessions.
    "crons": ["17 * * * *"]
  },
  "observability": { "enabled": true }
}
