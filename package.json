{
  "name": "southbag-social",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc --noEmit && node --check public/js/app.js",
    "test": "bash scripts/test.sh",
    "deploy": "npm run db:migrate:remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local && wrangler d1 migrations apply MEDIA --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote && wrangler d1 migrations apply MEDIA --remote",
    "cf-typegen": "wrangler types",
    "seed:local": "bash scripts/seed-local.sh"
  },
  "dependencies": {
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.144.0"
  }
}
